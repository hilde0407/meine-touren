<?xml version="1.0" encoding="utf-8"?>
<!-- Der eigene Server im Heimnetz läuft meist ohne HTTPS (http://192.168…); deshalb ist unverschlüsselter Verkehr erlaubt. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
