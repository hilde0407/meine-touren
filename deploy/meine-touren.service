[Unit]
Description=Meine Touren
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
User=@USER@
Group=@USER@
WorkingDirectory=@APP@
EnvironmentFile=@ENVF@
ExecStart=@APP@/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8080 --proxy-headers
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@DATA@ @BACKUPS@

[Install]
WantedBy=multi-user.target
